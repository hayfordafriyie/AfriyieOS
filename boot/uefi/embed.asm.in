; SPDX-License-Identifier: MIT
; AfriyieOS — embed the kernel image into the UEFI application
;
; The kernel binary is linked INTO the boot bridge's .rodata rather than being
; loaded from the ESP as a separate file. For v0.1 this is a deliberate
; risk-reduction choice:
;
;   * no SimpleFileSystem protocol code, no path handling, no long-file-name
;     corner cases
;   * exactly one file on the EFI System Partition (EFI/BOOT/BOOTX64.EFI), so
;     nothing can be missing, stale, or mismatched at boot
;   * the kernel and the boot bridge are always built from the same commit,
;     which structurally rules out the version-mismatch boot failure
;
; The trade-off is that a kernel change rebuilds the boot application, and the
; PE image grows by the size of the kernel. Both are acceptable at v0.1.
;
; From v0.2 the kernel is loaded from the ESP so it can be replaced without
; touching the bootloader; this file then disappears.
;
; AF_KERNEL_BIN is substituted by CMake from embed.asm.in.

; AF_KERNEL_BIN is substituted by CMake's configure_file (@AF_KERNEL_BIN@).
; Without the @...@ placeholder CMake has nothing to replace and the literal
; fallback below is used, which is how this file first shipped — and the
; resulting error, "incbin: unable to get length of file `kernel.bin'", points
; at NASM rather than at the template that was never substituted.
%ifndef AF_KERNEL_BIN
%define AF_KERNEL_BIN "@AF_KERNEL_BIN@"
%endif

[bits 64]

section .rodata

global af_kernel_image_start
global af_kernel_image_end

align 16
af_kernel_image_start:
    incbin AF_KERNEL_BIN
af_kernel_image_end:

; The GNU-stack note is an ELF concept. This file is assembled for the UEFI
; target, so the object is PE/COFF — emitting an ELF note section there would
; create a bogus section that only the linker script's /DISCARD/ would remove.
%ifidn __OUTPUT_FORMAT__, elf64
section .note.GNU-stack noalloc noexec nowrite progbits
%endif
